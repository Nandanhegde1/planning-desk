# ===========================================================================
# MODEL  - fill in exactly one block
# ===========================================================================
# openai  - any OpenAI-compatible base url, Gemini included  <- use this
# foundry - Microsoft Foundry / Azure OpenAI on the /openai/v1 route
# azure   - legacy per-deployment Azure OpenAI route
# ollama  - a local model, no key needed
# github  - GitHub Models, retired 30 July 2026; no longer works
LLM_PROVIDER=openai
# Reasoning models (GPT-5 family, o-series) accept only the default of 1 and
# reject anything else. The client detects that and drops the parameter, so this
# setting only matters for models that do support it. Keep 1 for Gemini 3.x:
# Google warns that lower values can make it loop.
LLM_TEMPERATURE=1

# Reasoning models only, and optional. minimal or low keeps the agent loop
# responsive; the default of medium spends thinking budget on tool selection,
# which does not need it. Leave empty to not send the parameter at all.
LLM_REASONING_EFFORT=low

# --- foundry ---------------------------------------------------------------
# Endpoint is the resource base only. No path, no trailing slash. It ends in
# either .openai.azure.com or .services.ai.azure.com. If you copied a URL that
# contains /openai/v1 or /api/projects, trim it back to the host.
# Deployment is the name you gave the deployment in the portal, which is not
# necessarily the model name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Only the legacy "azure" provider reads this. The v1 route versions itself.
AZURE_OPENAI_API_VERSION=2024-10-21

# --- openai-compatible: Gemini ---------------------------------------------
# Free tier, no card. Key from aistudio.google.com, sent as a Bearer token.
# 3.5 Flash-Lite has far more free requests per day than 3.8 Flash; the live
# figures are at aistudio.google.com/rate-limit. The free tier may use inputs for
# training, so set PUBLIC_NOTICE below if the deployment is public.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- ollama ----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1

# ===========================================================================
# WEB SEARCH  - optional, everything else runs without it
# ===========================================================================
# tavily - 1,000 credits a month, free, no card. Sign up at tavily.com,
#          copy the key from the dashboard, it starts with tvly-
# brave  - requires a card at signup and meters every query. Avoid.
# none   - the search tool reports itself unavailable and nothing breaks
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# ===========================================================================
# AGENT CEILINGS
# ===========================================================================
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS_PER_TURN=60000
AGENT_TOOL_TIMEOUT=45

# Conversation memory is bounded by turns, not messages: one tool-heavy turn can
# append a dozen tool messages, and a flat message window evicts what you said in
# order to keep tool output. Turns beyond the ceiling are dropped whole.
AGENT_MAX_HISTORY_TURNS=12
# Recent turns keep full tool payloads; older turns keep every spoken message and
# stub their tool results. Raise if follow-ups need older numbers verbatim.
AGENT_TOOL_DETAIL_TURNS=2

# Every caller together, over a rolling 24 hours. Keep it under what the model's
# free tier allows per day: a turn makes one to five model calls. 0 turns it off.
DAILY_TURN_CAP=100
# One line in the status strip. Leave empty to show nothing.
PUBLIC_NOTICE=Runs on a free model tier that may use what you type for training. Do not enter personal details.

# Optional. Routes every Open-Meteo call through a pass-through (edge/ in this
# repo), for hosts whose shared outbound address spends Open-Meteo's per-IP daily
# quota. Leave empty to call Open-Meteo directly.
OPEN_METEO_PROXY=

# Free APIs ask you to identify yourself. Nominatim wants a contact address.
HTTP_USER_AGENT=planning-desk/0.1 (you@example.com)
